# ──────────────────────────────────────────────────────────────────────────
#  Configuración de WordPress AISLADO para gestordesalud.co
#  Copia este archivo a «.env» y cambia las contraseñas.
#  El instalador (install-wordpress.sh) genera este .env automáticamente
#  con contraseñas aleatorias seguras si no existe.
# ──────────────────────────────────────────────────────────────────────────

# Puerto LOCAL donde queda WordPress (solo 127.0.0.1, no expuesto a internet).
# El proxy del servidor (Caddy/Nginx) enruta el dominio hacia este puerto.
# Debe estar LIBRE — el instalador lo verifica antes de arrancar.
WP_PORT=8090

# Base de datos propia de este WordPress (aislada, no comparte con nadie).
DB_NAME=gestordesalud
DB_USER=gestordesalud
DB_PASSWORD=cambia-esta-clave
DB_ROOT_PASSWORD=cambia-esta-clave-root
